# Copy this file to .env and put your own key in it. Never share or commit .env.
# Without a valid key the app runs in MOCK MODE (a rule-based stand-in model, for testing only).

# Groq API key (free tier works; get one at console.groq.com).
GROQ_API_KEY=gsk_REPLACE_ME
# Model served by Groq.
GROQ_MODEL=openai/gpt-oss-120b

# 1 = force offline mock mode. 0 = use the real model when a key is present.
SECONDLOOK_MOCK=0

# Optional settings (defaults shown; these are the values used for all reported results).
# SECONDLOOK_TEMPERATURE=0.2
# SECONDLOOK_REASONING_EFFORT=low
# SECONDLOOK_MAX_QUESTIONS=2

# Optional: use OpenRouter instead of Groq (same model; uses the openai package from requirements.txt).
# SECONDLOOK_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-REPLACE_ME
